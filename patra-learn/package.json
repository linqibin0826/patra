{
  "name": "patra-learn",
  "version": "0.1.0",
  "private": true,
  "description": "Patra 学习站 — 把你的系统，一条线一条线学明白",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start -p 4001",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "content:report": "tsx scripts/content-report.ts",
    "content:check-file": "tsx scripts/content-check-file.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@gsap/react": "^2.1.2",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.0",
    "gsap": "^3.15.0",
    "next": "^16.3.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.1.3",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28"
    }
  }
}
