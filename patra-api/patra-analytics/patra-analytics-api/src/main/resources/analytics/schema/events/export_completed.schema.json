{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patra.linqibin.dev/schemas/analytics/events/export_completed.schema.json",
  "title": "Export Completed",
  "x-patra-version": "1-0-0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "enum": [
        "ris",
        "bibtex",
        "csv",
        "csl-json"
      ]
    },
    "scope": {
      "enum": [
        "items",
        "collection",
        "public_collection",
        "library_all",
        "library_unfiled"
      ]
    },
    "article_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    }
  },
  "required": [
    "format",
    "scope",
    "article_count"
  ]
}
