{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patra.linqibin.dev/schemas/analytics/defs.schema.json",
  "title": "analytics 公共类型",
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z(?![\\s\\S])",
      "minLength": 24,
      "maxLength": 24,
      "description": "RFC 3339，UTC，毫秒精度"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36,
      "description": "小写 UUID"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}(?![\\s\\S])",
      "description": "雪花 / 自增 ID 的十进制字符串"
    },
    "article_id": {
      "$ref": "#/$defs/entity_id",
      "description": "catalog 文献 ID（门户 Paper.id）"
    },
    "user_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/entity_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "登录用户 ID；未登录为 null"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}(?![\\s\\S])",
      "minLength": 43,
      "maxLength": 43
    },
    "schema_version_model_1": {
      "type": "string",
      "pattern": "^1-[0-9]+-[0-9]+(?![\\s\\S])",
      "description": "SchemaVer，接受 MODEL 为 1 的任意版本"
    },
    "page_path": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^/[^?#]*(?![\\s\\S])",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ],
      "description": "只含路径，不含查询串与片段"
    },
    "page_type": {
      "enum": [
        "home",
        "search",
        "article",
        "journal",
        "library",
        "collection",
        "profile",
        "settings",
        "notifications",
        "post",
        "history",
        "privacy",
        "auth",
        "other"
      ]
    },
    "list_type": {
      "enum": [
        "feed_latest",
        "feed_cited",
        "feed_hot",
        "search",
        "related",
        "related_topic",
        "collection",
        "library"
      ]
    },
    "referrer_host": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]{1,253}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
