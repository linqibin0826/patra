{
  "name": "patra-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Patra C-end portal — medical literature discovery UI",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 4000",
