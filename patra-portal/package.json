    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "lucide-react": "^1.47.0",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.1.0",
    "next": "^16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
