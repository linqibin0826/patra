
# PostgreSQL Deployment
POSTGRES_PASSWORD=123456
POSTGRES_PORT=15432

# Redis Configuration
# 宿主机端口：core 栈把 redis 容器的 6379 映射到这里。.env.common 的 REDIS_PORT 是容器网络内的 6379，同名不同义
REDIS_PORT=16379

# Nacos Configuration（NACOS_AUTH_* 三件套在 .env，本文件仅放可公开值）
NACOS_PORT=8848

# mysql-ops 配置（运维组件用 MySQL，业务库走 PG）
MYSQL_OPS_ROOT_PASSWORD=patra_ops_root_dev
MYSQL_OPS_USERNAME=xxl_job
MYSQL_OPS_PASSWORD=xxl_job_dev
