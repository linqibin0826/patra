# 复制到 ~/.patra/secrets/identity.env，权限 600，不进仓库。
# 人机验证的凭据，说明见 patra-api/patra-identity/README.md 第 19 节。当前厂商缺凭据时 identity 起不来。

# Cloudflare Turnstile。线上用绑定 patra.linqibin.dev 的真实值。
# 本机用官方测试值：SITE_KEY=1x00000000000000000000AA，SECRET=1x0000000000000000000000000000000AA
PATRA_IDENTITY_TURNSTILE_SITE_KEY=
PATRA_IDENTITY_TURNSTILE_SECRET=

# TRUSTTURN。当前用哪家看 nacos/dev/patra-identity.yaml 的 provider；没用它时可以留空。
PATRA_IDENTITY_TRUSTTURN_SITE_KEY=
PATRA_IDENTITY_TRUSTTURN_APP_SECRET=
