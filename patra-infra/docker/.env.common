# ============================================================
# Patra 应用容器 - 共享基建坐标（非敏感 dev 默认值，随仓库提交）
# ============================================================
# 安全：这里只放内网 dev 默认值（人尽皆知、服务仅在 tailscale 内网暴露，公网打不到端口）和公钥。
# 密钥（Redis 密码、网关私钥、外部数据源 API key 等）放在仓库外的 ~/.patra/secrets/，
# 由 compose 的 env_file 按绝对路径叠加加载，见 README「密钥」。
# 坐标用 mini 主机名 + 宿主机映射端口，与 IDE 的 dev 配置写法一致；容器经 compose 的 extra_hosts
# 把 linqibins-mac-mini 解析到 OrbStack 宿主机网关，不经过 tailscale。

# Spring profile：容器统一用 container（专为环境变量注入设计）。
# 注：container 非「生产环境」，只是「容器化部署」这一运行形态；prod 预留给未来真正的云生产。
SPRING_PROFILES_ACTIVE=container

# 日志目录（镜像内 appuser 可写）
PATRA_LOG_DIR=/app/logs

# 基础设施所在主机（IDE 里是 mini 的 tailscale IP；yml 里 Nacos、RocketMQ namesrv、xxl-job admin 的地址默认跟随它）
PATRA_INFRA_HOST=linqibins-mac-mini

# --- Nacos 服务发现（地址跟随 PATRA_INFRA_HOST:8848）---
# 账号 patra-app 在仓库外的 ~/.patra/secrets/nacos.env（compose env_file，必需），这里不放

# --- MinIO 对象存储（宿主机映射端口 19000，内网 dev 默认凭据）---
# 注：minioadmin/minioadmin123 即 docker-compose.storage.yaml 的 dev 默认，已是公开 dev 凭据
MINIO_ENDPOINT=http://linqibins-mac-mini:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# --- RocketMQ namesrv、xxl-job admin：yml 默认跟随 PATRA_INFRA_HOST（9876、7070），这里不设 ---

# --- Redis（宿主机映射端口 16379，所有服务共用 0 号库）---
# 密码不在这里：在 ~/.patra/secrets/redis.env，只有 catalog、identity、gateway 加载。
REDIS_HOST=linqibins-mac-mini
REDIS_PORT=16379
