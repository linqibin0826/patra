# ingest 专属（非敏感 dev 默认值）。共享坐标（Nacos / RocketMQ namesrv / xxl-job admin）见 .env.common。
# 密钥写 ~/.patra/secrets/ingest.env（仓库外，见 README「密钥」）。

# 数据库（patra-net 服务名 postgres:5432）
INGEST_DB_URL=jdbc:postgresql://postgres:5432/patra_ingest
INGEST_DB_USERNAME=postgres
INGEST_DB_PASSWORD=123456

# xxl-job executor 日志目录（admin 地址见 .env.common；executor IP 留空，patra-net 内自动探测）
XXL_JOB_EXECUTOR_LOG_PATH=/app/logs/xxl-job/patra-ingest

# RocketMQ ACL：内网无鉴权，AK/SK 留空（application 默认空）。
# 需要时 ROCKETMQ_AK / ROCKETMQ_SK 写入 ~/.patra/secrets/ingest.env（仓库外）。

# 对象存储 bucket（endpoint/凭据见 .env.common）。ingest 下载产物缓存桶。
MINIO_BUCKET=patra-ingest-cache
