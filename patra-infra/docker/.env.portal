# ============================================================
# Patra portal 容器 - 运行时坐标（非敏感 dev 默认值，随仓库提交）
# ============================================================
# portal 是 BFF：Next.js 服务端读 PATRA_GATEWAY_BASE_URL 调 gateway，地址不下发浏览器。
# 坐标用 patra-net 容器服务名 + 容器内端口（非宿主映射端口）。
# 密钥（如有）写进 ~/.patra/secrets/portal.env（仓库外，缺失时跳过，见 README「密钥」）。

# Patra Gateway 地址（patra-net 服务名 gateway + 容器内端口 9528）
PATRA_GATEWAY_BASE_URL=http://gateway:9528

# Next.js standalone server 监听端口（与 compose ports 映射一致）
PORT=4000

NODE_ENV=production
